class Solution {
    public int minimumPushes(String word) {
        int alp[]= new int[26];
        for(char ch:word.toCharArray()){
            alp[ch-'a']++;
        }
        Arrays.sort(alp);
        int ans = 0;
        int idx = 0;
        for(int i=25;i>=0;i--){
            if (alp[i] == 0){
                break;
            }
            ans=ans+alp[i]*(idx/8+1);
            idx++;
        }
        return ans;
    }
}