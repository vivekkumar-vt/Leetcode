/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {
    public List<List<Integer>> zigzagLevelOrder(TreeNode root) {
         List<List<Integer>> res =new ArrayList<>();
        Queue<TreeNode> q = new LinkedList<>();
        if(root==null){
            return res;
        }
        int left=1;
        q.add(root);
        while(!q.isEmpty()){
            int n = q.size();
            List<Integer> ans = new ArrayList<>();
            if(left==1){
                for(int i=0;i<n;i++){
                    TreeNode curr = q.poll();
                    ans.add(curr.val);
                    if(curr.left != null){
                        q.add(curr.left);
                    }
                    if(curr.right != null){
                        q.add(curr.right);
                    }
                }
                res.add(ans);
            }
            else{
                Stack<Integer> st = new Stack<>();
                for(int i=0;i<n;i++){
                    TreeNode curr = q.poll();
                    st.push(curr.val);
                    if(curr.left != null){
                        q.add(curr.left);
                    }
                    if(curr.right != null){
                        q.add(curr.right);
                    }
                }
                while(!st.isEmpty()){
                    ans.add(st.pop());
                }
                res.add(ans);
            }
            left=1-left;
        }
        return res;
    }
}